        1440,
        0
      ],
      "webhookId": "6bcd6892-455b-4a59-8384-c8a599ed55b2"
    },
    {
      "parameters": {
        "jsCode": "const ctx = $('Wait 1s').item.json;\nconst html = $input.first().json.rawHtml;\nif (typeof html !== 'string') throw new Error('Search returned no HTML');\nif (/authwall|captcha|security verification/i.test(html)) throw new Error('LinkedIn blocked the search');\nconst clean = s => String(s || '').replace(/<[^>]+>/g, ' ').replace(/&amp;/g, '&').replace(/&#39;/g, \"'\").replace(/&quot;/g, '\"').replace(/&nbsp;/g, ' ').replace(/\\s+/g, ' ').trim();\nconst field = (block, cls) => clean((block.match(new RegExp('class=\"[^\"]*' + cls + '[^\"]*\"[^>]*>([\\\\s\\\\S]*?)<\\\\/(?:h3|h4|span|div)', 'i')) || [])[1]);\nconst normalize = s => s.toLowerCase().replace(/full[\\s-]*stack/g, 'fullstack').replace(/front[\\s-]*end/g, 'frontend').replace(/[^a-z0-9]+/g, ' ').trim();\nconst terms = normalize(ctx.keywords).split(' ');\nconst blocks = html.split(/<\\/li>/i).filter(b => /base-card/.test(b));\nif (html.trim() && !blocks.length && !/no results|no jobs/i.test(html)) throw new Error('Unrecognized search response; inspect LinkedIn markup');\nconst now = Date.now(), jobs = [], seen = new Set(), ids = [];\nfor (const b of blocks) {\n const id = (b.match(/urn:li:jobPosting:(\\d+)/) || b.match(/\\/jobs\\/view\\/(?:[^\"?\\s]*-)?(\\d{6,})/ ) || [])[1];\n if (!id) throw new Error('Job card missing ID; inspect LinkedIn markup');\n ids.push(id);\n const title = field(b, 'base-search-card__title');\n if (!terms.every(t => normalize(title).split(' ').includes(t))) continue;\n const location = field(b, 'job-search-card__location');\n if (!/tamil\\s*nadu|chennai|madras|bengaluru|bangalore/i.test(location)) continue;\n const tm = b.match(/<time\\b([^>]*)>([\\s\\S]*?)<\\/time>/i);\n const date = tm ? (tm[1].match(/datetime=\"([^\"]+)\"/) || [])[1] || '' : '';\n const label = clean(tm && tm[2]).toLowerCase();\n let age = NaN;\n if (/T\\d\\d:\\d\\d.*(?:Z|[+-]\\d\\d:\\d\\d)$/i.test(date)) age = now - Date.parse(date);\n else if (/^(just now|moments? ago)$/.test(label)) age = 0;\n else {\n  const rel = label.match(/^(\\d+)\\s*(seconds?|secs?|minutes?|mins?)\\s+ago$/);\n  if (rel) age = Number(rel[1]) * (/^(second|sec)/.test(rel[2]) ? 1000 : 60000);\n }\n if (!Number.isFinite(age) || age < 0 || age >= 3600000 || seen.has(id)) continue;\n seen.add(id);\n jobs.push({job_id:id, job_title:title, job_owner:field(b,'base-search-card__subtitle'),\n  job_link:'https://www.linkedin.com/jobs/view/' + id, job_posted_date:date,\n  job_location:location, posted_ago:label, job_snippet:location + ' | ' + label,\n  source:'LinkedIn', fetched_at:new Date(now).toISOString(), search_keyword:ctx.keywords,\n  dedup_hash:'linkedin:' + id});\n}\nconst signature = ids.join(',');\nif (blocks.length && signature === ctx.previous_signature) throw new Error('LinkedIn repeated a page; pagination stopped');\nreturn [{json:{...ctx, jobs, jobs_count:jobs.length, raw_count:blocks.length, signature}}];"
      },
