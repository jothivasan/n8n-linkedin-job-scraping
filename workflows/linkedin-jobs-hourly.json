      "parameters": {
        "jsCode": "return $input.all().map((item, i) => ({json: {\n  keywords: String(item.json.keyword || '').replace(/\\+/g, ' ').trim(),\n  location: String(item.json.location || '').trim(),\n  start: 0, page_num: 1, max_pages: 20, time_filter: 'r3600'\n}, pairedItem: {item: i}}));"
      },
