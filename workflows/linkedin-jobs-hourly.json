      "id": "24ea9dc1-f868-47de-a476-43c606612e91",
      "name": "Expand Jobs",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        2400,
        0
      ]
    },
    {
      "parameters": {
        "jsCode": "return $input.all().map((item, index) => {\nvar job = Object.assign({}, $('Has New Jobs?').itemMatching(index).json);\nvar rawData = item.json;\nvar html = rawData.rawHtml || (rawData.data && rawData.data.rawHtml) || '';\n\nif (!html || !/show-more-less-html__markup/.test(html)) throw new Error('Missing job detail content for ' + job.job_id);\n\n// Description from .show-more-less-html__markup\nvar descMatch = html.match(/class\\s*=\\s*\"[^\"]*show-more-less-html__markup[^\"]*\"[^>]*>([\\s\\S]*?)<\\/div>/i);\njob.job_description = descMatch\n  ? descMatch[1].replace(/<[^>]+>/g, ' ').replace(/\\s+/g, ' ').trim().slice(0, 3000)\n  : '';\n\n// Hiring person from linkedin.com/in/ anchor\nvar hirerName = '', hirerUrl = '';\nvar profileMatch = html.match(/<a[^>]+href\\s*=\\s*\"(https?:\\/\\/[^\"]*linkedin\\.com\\/in\\/[^\"]+)\"[^>]*>([\\s\\S]*?)<\\/a>/i);\nif (profileMatch) {\n  hirerUrl = profileMatch[1];\n  var anchorText = profileMatch[2].replace(/<[^>]+>/g, '').replace(/\\s+/g, ' ').trim();\n  if (anchorText) {\n    hirerName = anchorText;\n  }\n}\njob.hiring_person     = hirerName;\njob.hiring_person_url = hirerUrl;\n\n// Job criteria from .description__job-criteria-item blocks\nvar criteria = {};\nvar criteriaRx = /class\\s*=\\s*\"[^\"]*description__job-criteria-item[^\"]*\"([\\s\\S]*?)(?=class\\s*=\\s*\"[^\"]*description__job-criteria-item|<\\/ul|$)/gi;\nvar cMatch;\nwhile ((cMatch = criteriaRx.exec(html)) !== null) {\n  var cBlock = cMatch[1];\n  var lm = cBlock.match(/class\\s*=\\s*\"[^\"]*description__job-criteria-subheader[^\"]*\"[^>]*>([\\s\\S]*?)<\\//i);\n  var vm = cBlock.match(/class\\s*=\\s*\"[^\"]*description__job-criteria-text[^\"]*\"[^>]*>([\\s\\S]*?)<\\//i);\n  if (lm && vm) {\n    var lbl = lm[1].replace(/<[^>]+>/g, '').replace(/\\s+/g, ' ').trim().toLowerCase();\n    var val = vm[1].replace(/<[^>]+>/g, '').replace(/\\s+/g, ' ').trim();\n    if (lbl) criteria[lbl] = val;\n  }\n}\njob.seniority_level = criteria['seniority level'] || '';\njob.employment_type = criteria['employment type'] || '';\njob.job_function    = criteria['job function']    || '';\njob.industries      = criteria['industries']      || '';\n\nreturn {json: job, pairedItem: {item: index}};\n});"
      },
